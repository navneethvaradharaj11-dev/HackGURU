# Application Server
PORT=5000
NODE_ENV=development

# Database Adapter Mode (inmemory | prisma)
DATABASE_ADAPTER="inmemory"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ace_ai_db?schema=public"

# Security & Authentication
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# AI Models
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_MODEL="gpt-4o-mini"
HUGGINGFACE_MODEL="mistralai/Mistral-7B-Instruct-v0.2"

# Gemini Credentials Pool (10 Keys)
GEMINI_API_KEY_1="your_gemini_key_1"
GEMINI_API_KEY_2="your_gemini_key_2"
GEMINI_API_KEY_3="your_gemini_key_3"
GEMINI_API_KEY_4="your_gemini_key_4"
GEMINI_API_KEY_5="your_gemini_key_5"
GEMINI_API_KEY_6="your_gemini_key_6"
GEMINI_API_KEY_7="your_gemini_key_7"
GEMINI_API_KEY_8="your_gemini_key_8"
GEMINI_API_KEY_9="your_gemini_key_9"
GEMINI_API_KEY_10="your_gemini_key_10"

# OpenAI Credentials Pool (5 Keys)
OPENAI_API_KEY_1="your_openai_key_1"
OPENAI_API_KEY_2="your_openai_key_2"
OPENAI_API_KEY_3="your_openai_key_3"
OPENAI_API_KEY_4="your_openai_key_4"
OPENAI_API_KEY_5="your_openai_key_5"

# Hugging Face Credentials Pool (2 Keys)
HF_API_KEY_1="your_hf_key_1"
HF_API_KEY_2="your_hf_key_2"

# Offline Fallback
ENABLE_MOCK_AI_FALLBACK=true

# Engine Config
RECOMMENDATION_TOP_CANDIDATES_LIMIT=50
RECOMMENDATION_FINAL_LIMIT=10
